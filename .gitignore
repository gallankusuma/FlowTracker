# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template itself — a fresh clone should get a documented
# config contract, not silence (2026-08-12 review: this repo had no tracked
# .env.example anywhere, which was part of why nobody had one place to look
# when a DB credential went stale). Real .env/.env.local/etc. still ignored.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ── scraper (Node/Python backend) ──────────────────────────────────────────
scraper/node_modules/
scraper/__pycache__/
scraper/.venv/
scraper/*.pyc

# AWO runtime state — rewritten by the nightly cron, not source.
# Committing these would make every pull a merge conflict against the server.
scraper/awo-weights.json
scraper/awo-challenger.json
scraper/awo-optimization-result.json

# ── ad-hoc backups ─────────────────────────────────────────────────────────
# The whole point of introducing version control here is to stop doing this.
*.bak
*.bak[0-9]
*.backup_*
backup-*/
revise/
Revisi/
*.rar

# ── local scratch ──────────────────────────────────────────────────────────
*.log

# ── local tooling config ───────────────────────────────────────────────────
# Per-machine Claude Code permissions. Not shared config, and it accumulates
# literal commands — which is how the production VPS address ended up committed.
.claude/settings.local.json

# Written by the deploy, not by a developer: the commit a box is actually running.
scraper/.deployed-commit

# Scratch file for pasting review feedback. Deliberately untracked: it has twice
# held things that must never reach a public repo — most recently a rotated
# MySQL password and an admin login, one `git add .` away from being pushed.
# The previous credential leak reached production via a committed test file and
# needed git-filter-repo to purge, so this one is kept out by construction
# rather than by remembering.
Review.md
