# Copy this file to .env and fill in real values. .env is gitignored (see
# .gitignore) and must NEVER be committed or included in backups/archives —
# per the 2026-07-30 security review, any secret that ever lands in a shared
# ZIP/RAR/backup must be treated as already exposed, regardless of intent.

# MySQL — shared with other apps on this VPS (erp-backend, erp-genjaya-*,
# xfact, cylo, idxflash). Do not rotate without coordinating all of them.
DB_HOST=localhost
DB_USER=erp_user
DB_PASSWORD=
DB_NAME=erp_manufacturing

# Index Alpha broker-data API key
INDEX_ALPHA_KEY=

# FlowTracker/SahamIntel integration key (used by ftlogin.js, server.js FT pull)
FT_KEY=

# flowtracker.id account password (used by server.js's FT.id concentration pull
# and test-ft-login.js). A real account credential, not a rotation-neutral API
# key — moved out of source 2026-07-30 per explicit instruction.
FT_PASS=

# xfact JWT secret (used by test-xfact-api.js and any xfact-integration code)
JWT_SECRET=

# Simple shared-secret admin API key — required by admin/optimizer/cron/scrape
# endpoints added 2026-07-30 (see server.js requireAdminKey middleware).
# Generate a long random value, e.g.: openssl rand -hex 32
ADMIN_API_KEY=

# CORS allowlist — comma-separated origins, e.g.:
#   CORS_ALLOWED_ORIGINS=https://flowtracker.id,https://www.flowtracker.id
# NOTE (2026-07-31): the value above is a PLACEHOLDER EXAMPLE, not a
# confirmed production domain — "flowtracker.id" elsewhere in this codebase
# refers to a separate third-party site this app pulls concentration data
# FROM (see FT_HOST/FT_PASS above), not necessarily this app's own public
# origin. Fill in the actual frontend origin(s) before relying on this — if
# left unset, server.js falls back to allowing all origins (*) rather than
# guessing wrong and silently locking out the real frontend.
CORS_ALLOWED_ORIGINS=
